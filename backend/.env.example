PROJECT_NAME=CareerSphere AI

# ---------------------------------------------------------------------------
# PostgreSQL (primary relational database)
# Use postgresql+psycopg:// for SQLAlchemy + psycopg v3
# When the backend runs on the host and Postgres is in Docker:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/careersphere_db
# When the backend also runs inside Docker on the same compose network, use:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/careersphere_db

# Optional compose credentials (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=careersphere_db

# ---------------------------------------------------------------------------
# Redis (OTP cache, availability cache) — MUST run via Docker
# Host machine → Docker Redis:
REDIS_URL=redis://localhost:6379/0
# Inside Docker network:
# REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Qdrant (vector database for embeddings / semantic search)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PROFILES=user_profiles
QDRANT_COLLECTION_CONTENT=career_content
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Optional override. Leave blank to detect the actual model dimension.
EMBEDDING_DIMENSION=

# ---------------------------------------------------------------------------
# MinIO (file / media object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=careersphere
MINIO_SECURE=false
MINIO_PUBLIC_URL=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------------------------------------------------------------------------
# Ollama (local LLM — optional; start with: docker compose --profile ai up -d ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
AI_MAX_PROMPT_CHARS=8000
AI_CONTEXT_MESSAGES=20
AI_CONTEXT_CHARS=16000

# AI Interviewer (uses the Ollama model above)
OLLAMA_INTERVIEW_TIMEOUT_SECONDS=240
INTERVIEW_AI_MAX_CONCURRENCY=2
# Follow-ups after practical assessments (extra to the question count; 0 disables)
INTERVIEW_MAX_FOLLOW_UPS=2
INTERVIEW_FOLLOW_UP_MIN_REMAINING_SECONDS=180
INTERVIEW_SUBMISSION_GRACE_SECONDS=15
# Optional voice-answer transcription (local Faster-Whisper). Leave blank to keep
# voice interviews disabled; text interviews always work. To enable:
#   pip install faster-whisper   then set e.g. INTERVIEW_WHISPER_MODEL=base.en
INTERVIEW_WHISPER_MODEL=
INTERVIEW_WHISPER_DEVICE=cpu
INTERVIEW_WHISPER_COMPUTE_TYPE=int8
INTERVIEW_TRANSCRIPTION_TIMEOUT_SECONDS=90
INTERVIEW_MAX_AUDIO_BYTES=8388608
INTERVIEW_MAX_AUDIO_SECONDS=180

# Gemini (semantic reranking; optional, falls back if unavailable)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RERANK_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# LanguageTool (grammar / writing assistant — not the AI model)
# Start with: docker compose --profile languagetool up -d languagetool
# API is expected at {LANGUAGETOOL_URL}/v2/check
LANGUAGETOOL_URL=http://localhost:8010
LANGUAGETOOL_LANGUAGE=en-US
LANGUAGETOOL_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# JWT
SECRET_KEY=change_this_to_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Email (Gmail App Password) — required for signup OTP
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
OTP_EXPIRE_MINUTES=10

# Short-lived Redis cache for username/email availability checks (seconds)
AVAILABILITY_CACHE_TTL=60

# ---------------------------------------------------------------------------
# Judge0 code execution (isolated CPU VM; see infra/judge0/README.md)
# Backend only — never expose these to the frontend. In development the API is
# reached through an SSH/SSM tunnel on localhost.
JUDGE0_API_URL=http://127.0.0.1:2358
# Application token (Judge0 AUTHN_TOKEN, sent as X-Auth-Token). The admin AUTHZ
# token stays on the Judge0 host and is not needed by the backend.
JUDGE0_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Real job listings for Career Matching (backend only — never exposed to the frontend)
# Company boards: comma-separated "slug=Company Name". Only add boards you have
# verified are the company's own public board (e.g. open the hosted board page).
JOB_GREENHOUSE_BOARDS=razorpaysoftwareprivatelimited=Razorpay,groww=Groww,druva=Druva,hackerrank=HackerRank,mongodb=MongoDB,databricks=Databricks,gitlab=GitLab,stripe=Stripe,rubrik=Rubrik,elastic=Elastic,coinbase=Coinbase,airbnb=Airbnb
JOB_LEVER_BOARDS=cred=CRED,meesho=Meesho,zeta=Zeta,paytm=Paytm,mindtickle=Mindtickle
JOB_ASHBY_BOARDS=sarvam=Sarvam,atlan=Atlan,openai=OpenAI,notion=Notion
# Import only listings in these locations (plus globally-remote ones). Empty = all.
# JOB_SYNC_LOCATION_KEYWORDS=india,bengaluru,bangalore,mumbai,pune,hyderabad,chennai,delhi,gurgaon,gurugram,noida
JOB_SYNC_INCLUDE_GLOBAL_REMOTE=true
JOB_SYNC_ENABLED=true
JOB_SYNC_INTERVAL_MINUTES=360
JOB_SYNC_ON_STARTUP=true
JOB_LISTING_MAX_AGE_DAYS=45
# Adzuna (free developer key; a licence is required for revenue/lead-generating use;
# each displayed listing must carry an "Adzuna" label linked to adzuna.co.uk)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_QUERIES=software developer,python developer,data analyst,devops engineer,frontend developer
# Remotive: keep false unless Remotive has granted permission — its public API
# terms forbid showing its jobs behind a sign-up wall.
REMOTIVE_ENABLED=false
REMOTIVE_CATEGORIES=software-dev,data,devops
# Admin endpoints (manual sync, provider status): comma-separated e-mails
ADMIN_EMAILS=
