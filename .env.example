# Copy to `.env` in the project root (or to `backend/.env`).
# The FastAPI settings loader reads both `.env` and `../.env` relative to `backend/`.

PROJECT_NAME=CareerSphere AI

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/careersphere_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=careersphere_db

# Redis (Docker)
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PROFILES=user_profiles
QDRANT_COLLECTION_CONTENT=career_content
EMBEDDING_DIMENSION=768

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=careersphere
MINIO_SECURE=false
MINIO_PUBLIC_URL=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# JWT
SECRET_KEY=change_this_to_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Email / OTP
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
OTP_EXPIRE_MINUTES=10
AVAILABILITY_CACHE_TTL=60
